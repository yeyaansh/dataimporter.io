{
  "_about": "Design tokens for DataPilot (Dataimporter.io clone). Roles, not raw hex. replica-brand swaps values, names stay. Check: python3 contrast.py tokens.json",

  "color": {
    "bg":           "#ffffff",
    "bg-raised":    "#fafbfc",
    "surface":      "#f4f5f7",
    "surface-alt":  "#eceef1",
    "border":       "#dfe1e6",
    "border-input": "#8993a4",
    "border-focus": "#3451b2",

    "text":         "#172b4d",
    "text-muted":   "#626f86",
    "text-subtle":  "#8993a4",
    "text-inverse": "#ffffff",

    "accent":       "#3451b2",
    "accent-hover": "#2b3f8e",
    "accent-light": "#edf2ff",
    "on-accent":    "#ffffff",

    "danger":       "#c9372c",
    "danger-hover": "#ae2a19",
    "danger-light": "#ffedeb",
    "on-danger":    "#ffffff",

    "success":      "#166b3f",
    "success-hover": "#115931",
    "success-light":"#e6fcef",
    "on-success":   "#ffffff",

    "warning":      "#9a4e00",
    "warning-light":"#fff8e1",
    "on-warning":   "#ffffff",

    "info":         "#0065ff",
    "info-light":   "#e9f2ff",

    "sidebar-bg":   "#1e2a3a",
    "sidebar-text": "#c7d2e0",
    "sidebar-active":"#3451b2",
    "sidebar-hover":"#263548"
  },

  "pairs": [
    ["text",        "bg"],
    ["text",        "surface"],
    ["text",        "bg-raised"],
    ["text-muted",  "bg"],
    ["text-muted",  "surface"],
    ["text-muted",  "bg-raised"],
    ["on-accent",   "accent"],
    ["on-accent",   "accent-hover"],
    ["on-danger",   "danger"],
    ["on-danger",   "danger-hover"],
    ["on-success",  "success"],
    ["on-warning",  "warning"],
    ["accent",      "bg"],
    ["accent",      "accent-light"],
    ["danger",      "bg"],
    ["danger",      "danger-light"],
    ["success",     "bg"],
    ["success",     "success-light"],
    ["warning",     "bg"],
    ["warning",     "warning-light"],
    ["sidebar-text","sidebar-bg"],
    ["text-inverse","sidebar-bg"],
    ["border-input","bg", "ui"],
    ["border-focus","bg", "ui"],
    ["text-subtle", "bg", "ui"]
  ],

  "font": {
    "sans":  "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, sans-serif",
    "mono":  "'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, monospace"
  },

  "type": {
    "xs":      {"size": 11, "line": 16, "weight": 500, "tracking": "0.02em"},
    "sm":      {"size": 13, "line": 18, "weight": 400, "tracking": "0"},
    "base":    {"size": 14, "line": 20, "weight": 400, "tracking": "0"},
    "md":      {"size": 16, "line": 24, "weight": 500, "tracking": "-0.01em"},
    "lg":      {"size": 20, "line": 28, "weight": 600, "tracking": "-0.02em"},
    "xl":      {"size": 24, "line": 32, "weight": 700, "tracking": "-0.02em"},
    "display": {"size": 32, "line": 40, "weight": 700, "tracking": "-0.03em"}
  },

  "space": {
    "0":  0,
    "px": 1,
    "0.5": 2,
    "1":  4,
    "1.5": 6,
    "2":  8,
    "3":  12,
    "4":  16,
    "5":  20,
    "6":  24,
    "8":  32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80
  },

  "radius": {
    "sm":   4,
    "md":   6,
    "lg":   8,
    "xl":   12,
    "2xl":  16,
    "pill": 999
  },

  "shadow": {
    "xs":   "0 1px 2px rgba(16,24,40,.05)",
    "sm":   "0 1px 3px rgba(16,24,40,.10), 0 1px 2px rgba(16,24,40,.06)",
    "md":   "0 4px 8px -2px rgba(16,24,40,.10), 0 2px 4px -2px rgba(16,24,40,.06)",
    "lg":   "0 12px 16px -4px rgba(16,24,40,.08), 0 4px 6px -2px rgba(16,24,40,.03)",
    "pop":  "0 20px 40px -8px rgba(16,24,40,.16)",
    "focus":"0 0 0 3px rgba(52,81,178,.35)"
  },

  "motion": {
    "fast":  "100ms",
    "base":  "150ms",
    "slow":  "250ms",
    "ease":  "cubic-bezier(.2,.8,.25,1)",
    "spring":"cubic-bezier(.34,1.56,.64,1)"
  },

  "layout": {
    "sidebar-width":    240,
    "sidebar-collapsed": 64,
    "header-height":     56,
    "content-max":      1280,
    "wizard-max":        960,
    "modal-sm":          480,
    "modal-md":          640,
    "modal-lg":          960,
    "breakpoint-sm":     640,
    "breakpoint-md":     768,
    "breakpoint-lg":    1024,
    "breakpoint-xl":    1280,
    "breakpoint-2xl":   1536
  },

  "z": {
    "dropdown":  50,
    "sticky":    100,
    "modal-bg":  200,
    "modal":     300,
    "popover":   400,
    "toast":     500
  }
}
